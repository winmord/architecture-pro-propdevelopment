        <mxCell id="5vTqob-R_sS665xJ21s2-54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;strong&gt;&lt;span&gt;Риск&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;: искажение данных&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong&gt;&lt;span&gt;Актуальность:&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;&amp;nbsp;данные видны всем, контроль внесения слабый. Искажение напрямую влияет на бронирование и &lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;span&gt;доверие&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;span&gt;Оценка&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;: &lt;/span&gt;&lt;span&gt;значительный&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="-430" y="290" as="geometry" />
        </mxCell>
        <mxCell id="5vTqob-R_sS665xJ21s2-55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;strong&gt;&lt;span&gt;Риск&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;:&amp;nbsp;&lt;/span&gt;&lt;span&gt;утечка данных&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong&gt;&lt;span&gt;Актуальность:&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span&gt;уже есть жалобы клиентов на чужие данные, множественные точки регистрации, нет ограничений со стороны систем обработки&lt;/span&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;span&gt;Оценка&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;:критический&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="269" width="360" x="-430" y="681" as="geometry" />
        </mxCell>
        <mxCell id="5vTqob-R_sS665xJ21s2-56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;strong&gt;&lt;span&gt;Риск&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;: утечка данных&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong&gt;&lt;span&gt;Актуальность:&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span&gt;один ИБ на всю компанию, нарушена передача информации между командами, нет единого хранилища секретов&lt;/span&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;span&gt;Оценка&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;:&lt;/span&gt;&lt;span&gt;критический&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="360" x="881" y="610" as="geometry" />
        </mxCell>
        <mxCell id="5vTqob-R_sS665xJ21s2-57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;strong&gt;&lt;span&gt;Риск&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;:&amp;nbsp;&lt;/span&gt;&lt;span&gt;утечка данных&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong&gt;&lt;span&gt;Актуальность:&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span&gt;отсутствие контроля доступа в системах обработки данных, не все ограничения передаются ИБ, API УК без политик&lt;/span&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;&lt;span&gt;Оценка&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;: &lt;/span&gt;&lt;span&gt;значительный&lt;/span&gt;&lt;/div&gt;" vertex="1">
